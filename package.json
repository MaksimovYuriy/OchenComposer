{
  "name": "OchenComposer",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:svg-browser": "node scripts/check-svg-export.mjs",
    "preview:compositions": "node scripts/preview-compositions.mjs",
    "preview:ai-scene": "node scripts/preview-ai-scene.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "node --watch --watch-path=src --watch-path=assets --watch-path=catalog --watch-path=scripts scripts/build.mjs",
    "pretest": "npm run build"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
